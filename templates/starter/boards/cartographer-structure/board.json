  "texts": [
    {
      "id": "text-ms9ns34x-3tiln",
      "text": "Cartographer structure",
      "position": {
        "x": 0,
        "y": -420
      },
      "size": "lg",
      "bold": true
    },
    {
      "id": "text-ms9ns34x-3uzhf",
      "text": "Every component in the frame it lives in, read left to right: the files that are the truth, the core that alone touches them, the modules both doors call, and the client that asks and renders.",
      "position": {
        "x": 0,
        "y": -370
      },
      "size": "md"
    },
    {
      "id": "text-ms9ns34x-3v79d",
      "text": "This board is also an example of a map: frames for grouping, paper cards for components, labelled arrows for flow, and a pill for the one thing both sides import.",
      "position": {
        "x": 0,
        "y": -320
      },
      "size": "sm",
      "italic": true
    }
  ],
