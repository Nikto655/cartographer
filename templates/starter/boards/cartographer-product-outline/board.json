  "texts": [
    {
      "id": "text-ms9ji4kd-2up3p",
      "text": "Cartographer, end to end — v4",
      "position": {
        "x": -44,
        "y": -230
      },
      "size": "lg",
      "bold": true
    },
    {
      "id": "text-ms9ji4kd-2vzr5",
      "text": "Read top to bottom: what it is, what you draw on, what you write, where it lives on the shelf, who it is for, what an agent may touch, and what keeps it safe.",
      "position": {
        "x": -44,
        "y": -180
      },
      "size": "sm",
      "italic": true
    },
    {
      "id": "text-ms9ji4kd-2wl06",
      "text": "Everything below this line is reachable by an agent — and nothing below it can destroy anything.",
      "position": {
        "x": -44,
        "y": 2262
      },
      "size": "sm",
      "italic": true
    }
