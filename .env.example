# Copy to .env and fill in. .env is git-ignored.
#
# Read by docker compose and by `npm run dev` alike. A real environment
# variable always wins over this file. Every option, with its default, is in
# docs/CONFIGURATION.md.

# ---- required on the first boot ----

# Creates the admin account, only while no accounts exist. It must change this
# password at first sign-in; after that, editing it here changes nothing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=Admin

# ---- deployment ----

# true once you sign in over https. Turning it on before then locks everyone
# out, because the browser drops the cookie over plain http.
# COOKIE_SECURE=false

# true when a reverse proxy sets X-Forwarded-For. Docker defaults this to true;
# `npm run dev` defaults it to false.
# TRUST_PROXY=true

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Log timestamps only; stored data is always UTC.
# TZ=UTC

# ---- development only (Docker sets these itself) ----

# DATA_DIR=./data
# The client's dev proxy follows PORT, so changing it here is enough.
# PORT=3000
# Every interface by default; 127.0.0.1 keeps the sign-in page off your network.
# HOST=0.0.0.0
